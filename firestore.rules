rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in [
        'SUPER_ADMIN',
        'ADMIN',
        'OPERATOR',
        'FINANCE'
      ];
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isSelf(driverId) || isAdmin();
      allow create: if isSelf(driverId);
      allow update: if isSelf(driverId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /passengers/{passengerId} {
      allow read: if isSelf(passengerId) || isAdmin();
      allow create: if isSelf(passengerId);
      allow update: if isSelf(passengerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if signedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /rideOffers/{offerId} {
      allow read, update: if signedIn() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /driverLocations/{driverId} {
      allow read: if isAdmin() || (signedIn() && driverId == request.auth.uid);
      allow write: if signedIn() && driverId == request.auth.uid;
    }

    match /pricing/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
