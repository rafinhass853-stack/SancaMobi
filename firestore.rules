rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in [
        'SUPER_ADMIN',
        'ADMIN',
        'OPERATOR',
        'FINANCE'
      ];
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /driverCompliance/{driverId} {
      allow read: if isSelf(driverId) || isAdmin();
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isSelf(driverId) || isAdmin();
      allow write: if isAdmin();
    }

    match /passengers/{passengerId} {
      allow read: if isSelf(passengerId) || isAdmin();
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if isSelf(storeId) || isAdmin();
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if signedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if signedIn() && (
        resource.data.storeId == request.auth.uid ||
        resource.data.courierId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /serviceOffers/{offerId} {
      allow read: if signedIn() && (
        resource.data.courierId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /rideOffers/{offerId} {
      allow read: if signedIn() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /driverLocations/{driverId} {
      allow read: if isAdmin() || (signedIn() && driverId == request.auth.uid);
      allow write: if false;
    }

    match /pricing/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if signedIn() && (
        resource.data.raterId == request.auth.uid ||
        resource.data.targetId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /menuCategories/{categoryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /menuItems/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /foodOrders/{orderId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.storeId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /paymentTransactions/{paymentId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid
        )
      );
      allow write: if false;
    }

    match /mercadoPagoOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
